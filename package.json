{
  "name": "weather-app-root",
  "version": "1.0.0",
  "description": "Weather App for Railway Deployment",
  "scripts": {
    "postinstall": "npm run install:api && npm run install:frontend",
    "install:api": "cd api && npm install",
    "install:frontend": "cd frontend && npm install",
    "build": "cd frontend && npm run build",
    "start": "cd api && node index.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "md-to-pdf": "^5.2.5",
    "puppeteer": "^25.0.2"
  }
}
